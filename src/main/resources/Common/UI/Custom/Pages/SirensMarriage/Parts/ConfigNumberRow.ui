$C = "../../../Common.ui";
$T = "../MarriageTheme.ui";

// One numeric config value on the admin page, appended into "#ConfigList". A
// themed twin of vanilla's Pages/Fields/NumberRow.ui - same #Label/#Input ids -
// because the vanilla row is styled in the navy palette this mod replaces
// everywhere else, and one navy row in a rose page looks like a bug.
//
//   #Label   .TextSpans   what the value does
//   #Detail  .Text        the config key it writes, so an admin can find it in
//                         the JSON without guessing
//   #Input   .Value       the number itself
Group {
  Anchor: (Height: 52, Bottom: 6);
  Background: (Color: #3D1530(0.85));
  Padding: (Horizontal: 12, Vertical: 6);
  LayoutMode: Left;

  Group {
    FlexWeight: 1;
    LayoutMode: Middle;
    Padding: (Right: 12);

    Label #Label {
      Anchor: (Height: 18);
      Style: (
        FontSize: 15,
        TextColor: #E3A4BC,
        HorizontalAlignment: Start,
        VerticalAlignment: Center,
        ShrinkTextToFit: true,
        MinShrinkTextToFitFontSize: 12
      );
    }

    Label #Detail {
      Anchor: (Height: 14);
      Style: (
        FontSize: 11,
        TextColor: #8C6373,
        HorizontalAlignment: Start,
        VerticalAlignment: Center,
        ShrinkTextToFit: true,
        MinShrinkTextToFitFontSize: 9
      );
    }
  }

  Group {
    Anchor: (Width: 130);
    LayoutMode: Middle;

    $C.@NumberField #Input {
      @Anchor = (Width: 130);
      Format: (MaxDecimalPlaces: 2, Step: 1, Placeholder: "0");
    }
  }
}
