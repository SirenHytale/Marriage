$C = "../../../Common.ui";
$T = "../MarriageTheme.ui";

// A read-only label/value line. Appended into the Overview category's "#InfoList"
// - one per stat (partner + online status, married-for duration, gifts given/
// received, teleports used, love notes sent). No button, no checkbox: display
// only.
//
//   #Label .TextSpans   the stat's caption (e.g. "Married for")
//   #Value .TextSpans / .Text   the stat's value - Java uses whichever property
//                                fits (.TextSpans for a translated/parametrised
//                                line, .Text for a plain number or duration
//                                string); both are valid on a Label.
Group {
  Anchor: (Height: 30, Bottom: 4);
  Padding: (Horizontal: 4);
  LayoutMode: Left;

  Label #Label {
    Anchor: (Width: 170);
    Style: (
      FontSize: 14,
      TextColor: #8C6373,
      HorizontalAlignment: Start,
      VerticalAlignment: Center
    );
  }

  Label #Value {
    FlexWeight: 1;
    Style: (
      FontSize: 15,
      RenderBold: true,
      TextColor: #FFF3F7,
      HorizontalAlignment: Start,
      VerticalAlignment: Center,
      ShrinkTextToFit: true,
      MinShrinkTextToFitFontSize: 11
    );
  }
}
