<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>plugin.siren</groupId>
    <artifactId>Marriage</artifactId>
    <version>2.2.0</version>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <property name="marriage.serverMods"
                                          value="C:\Users\Froggy\Documents\.HytaleMods\.hytale-server\Server\mods"/>
                                <property name="marriage.userMods"
                                          value="C:\Users\Froggy\AppData\Roaming\Hytale\UserData\Mods"/>

                                <!-- Delete-then-copy: overwriting a jar the live JVM has open
                                     leaves it with stale zip offsets and NoClassDefFoundError on
                                     not-yet-loaded classes. Each destination is finished before
                                     the next is touched. -->
                                <delete file="${marriage.serverMods}\${project.build.finalName}.jar"
                                        failonerror="false"/>
                                <available file="${marriage.serverMods}\${project.build.finalName}.jar"
                                           property="marriage.serverJarLocked"/>
                                <fail message="Could not replace ${project.build.finalName}.jar - it is locked. Stop the Hytale server, then build again."
                                      if="marriage.serverJarLocked"/>
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                      todir="${marriage.serverMods}"/>

                                <delete file="${marriage.userMods}\${project.build.finalName}.jar"
                                        failonerror="false"/>
                                <available file="${marriage.userMods}\${project.build.finalName}.jar"
                                           property="marriage.userJarLocked"/>
                                <fail message="Could not replace ${project.build.finalName}.jar in UserData - it is locked. Close the Hytale client, then build again."
                                      if="marriage.userJarLocked"/>
                                <copy file="${project.build.directory}/${project.build.finalName}.jar"
                                      todir="${marriage.userMods}"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>hytale-release</id>
            <url>https://maven.hytale.com/release</url>
        </repository>
        <repository>
            <id>hytale-pre-release</id>
            <url>https://maven.hytale.com/pre-release</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>com.hypixel.hytale</groupId>
            <artifactId>Server</artifactId>
            <version>0.6.0-pre.13.1</version>
        </dependency>
    </dependencies>

</project>